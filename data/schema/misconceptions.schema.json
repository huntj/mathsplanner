{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huntj/mathsplanner/main/data/schema/misconceptions.schema.json",
  "title": "MathsPlanner misconception catalogue",
  "description": "Shared misconception codes, so the same error is recognised everywhere it appears. Licensed CC BY 4.0.",
  "type": "object",
  "required": ["version", "misconceptions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "description": "Version of the catalogue (semver).",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "misconceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/misconception" }
    }
  },
  "$defs": {
    "misconception": {
      "type": "object",
      "required": ["code", "description"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Dot-separated upper-case code, e.g. FR.ADD.TOPS-AND-BOTTOMS.",
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:\\.[A-Z0-9]+(?:-[A-Z0-9]+)*)+$"
        },
        "description": {
          "description": "What the student does or believes.",
          "type": "string",
          "minLength": 1
        },
        "remediate": {
          "description": "Statement ID to step back to.",
          "type": "string"
        }
      }
    }
  }
}
