    "parts": [
      {
        "answer": {
          "correct": "A",
          "correctReason": "RA",
          "options": [
            {
              "content": [
                {
                  "t": "text",
                  "v": "True",
                },
              ],
              "id": "A",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "False",
                },
              ],
              "id": "B",
            },
          ],
          "reasons": [
            {
              "content": [
                {
                  "t": "text",
                  "v": "True. 90° is 90/360 = ¼ of a full turn, so the arc is ¼ of the circumference.",
                },
              ],
              "id": "RA",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "False. It is half, because 90 is half of 180.",
                },
              ],
              "id": "RB",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "False. The arc depends on the area, not the angle.",
                },
              ],
              "id": "RC",
            },
          ],
          "type": "choice-with-reason",
        },
        "marks": 2,
        "misconceptions": [
