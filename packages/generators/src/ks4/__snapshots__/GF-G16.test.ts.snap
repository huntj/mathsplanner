  {
    "archetype": "true-or-false-why",
    "diagrams": [],
    "key": {
      "depth": 4,
      "numbers": "friendly",
      "seed": 1,
      "statementId": "GF-G16",
      "version": "1.0.0",
    },
    "meta": {
      "calculator": false,
      "marks": 2,
      "minutes": 2,
      "tags": [],
    },
    "parts": [
      {
        "answer": {
          "correct": "A",
          "correctReason": "RA",
          "options": [
            {
              "content": [
                {
                  "t": "text",
                  "v": "True",
                },
              ],
              "id": "A",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "False",
                },
              ],
              "id": "B",
            },
          ],
          "reasons": [
            {
              "content": [
                {
                  "t": "text",
                  "v": "True. A prism has the same cross-section all the way along, so its volume is cross-section area × length; a cylinder is a prism with a circular cross-section.",
                },
              ],
              "id": "RA",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "False. You must add the three dimensions.",
                },
              ],
              "id": "RB",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "False. Only cuboids work like that; other prisms need length × width × height.",
                },
              ],
              "id": "RC",
            },
          ],
          "type": "choice-with-reason",
        },
        "marks": 2,
        "misconceptions": [
          {
            "answer": {
              "id": "RC",
              "type": "choice",
            },
            "code": "MEA.VOLUME.ADDS",
            "feedback": [],
          },
        ],
        "prompt": [
          {
            "t": "text",
            "v": "Is this true or false?",
          },
        ],
      },
    ],
    "solution": [
      {
        "say": [
          {
            "t": "text",
            "v": "V = A × l for every prism, including cylinders (A = πr²).",
          },
        ],
      },
    ],
    "stem": [
      {
        "t": "text",
        "v": "Ola says the volume of any right prism is the area of its cross-section multiplied by its length.",
      },
    ],
  },
