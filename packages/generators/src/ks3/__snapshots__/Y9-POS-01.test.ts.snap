            "t": "text",
            "v": "Is this true or false?",
          },
        ],
      },
    ],
    "solution": [
      {
        "say": [
          {
            "t": "text",
            "v": "Every length is multiplied by the scale factor, so ½ halves them. The angles stay the same.",
          },
        ],
      },
    ],
    "stem": [
      {
        "t": "text",
        "v": "Nina says that enlarging a shape by scale factor ½ makes it bigger, because it is an enlargement.",
      },
    ],
  },
