                  "v": "False",
                },
              ],
              "id": "B",
            },
          ],
          "reasons": [
            {
              "content": [
                {
                  "t": "text",
                  "v": "False. A scale factor between 0 and 1 makes every length smaller: scale factor ½ halves them.",
                },
              ],
              "id": "RA",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "True. Enlargements always make shapes bigger.",
                },
              ],
              "id": "RB",
            },
            {
              "content": [
                {
                  "t": "text",
                  "v": "True. You add ½ to every length.",
                },
              ],
              "id": "RC",
            },
          ],
          "type": "choice-with-reason",
        },
